# Raw source data is local-only and must never be committed.
data/raw/*
!data/raw/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Jupyter
.ipynb_checkpoints/

# Operating systems and editors
.DS_Store
Thumbs.db
.vscode/

# Tests and coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Temporary files, logs, and generated artifacts
*.log
*.tmp
*.bak
reports/figures/*
!reports/figures/.gitkeep
